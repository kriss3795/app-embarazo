  const map={
    "lima":g(`<ellipse cx="50" cy="56" rx="30" ry="32" fill="${salvia}"/><ellipse cx="42" cy="46" rx="9" ry="12" fill="#B6C7A2" opacity=".5"/><rect x="47" y="20" width="6" height="10" rx="3" fill="${hoja}"/>${hojita}`),
    "limón":g(`<ellipse cx="50" cy="55" rx="30" ry="33" fill="${dorado}"/><ellipse cx="41" cy="45" rx="8" ry="11" fill="#EBC98C" opacity=".6"/><circle cx="50" cy="20" r="4" fill="${hoja}"/><circle cx="50" cy="90" r="4" fill="#C79656"/>`),
    "durazno":g(`<circle cx="50" cy="56" r="32" fill="#F4A98E"/><path d="M50 26 q4 20 0 60" stroke="#E38E70" stroke-width="2" fill="none"/><ellipse cx="40" cy="46" rx="8" ry="10" fill="#F8C4B0" opacity=".6"/>${hojita}`),
    "arándano":g(`<circle cx="50" cy="54" r="30" fill="#7C8FC0"/><circle cx="50" cy="54" r="30" fill="#9AA9D4" opacity=".4"/><path d="M44 44 l6 6 l6 -6 l-6 -4 z" fill="#5C6E9E"/><ellipse cx="40" cy="44" rx="7" ry="9" fill="#B4BFE0" opacity=".5"/>`),
    "frambuesa":g(`<g fill="${rosa}">${[...Array(9)].map((_,i)=>`<circle cx="${40+(i%3)*10}" cy="${44+Math.floor(i/3)*10}" r="7"/>`).join('')}</g>${hojita}`),
    "aceituna":g(`<ellipse cx="50" cy="56" rx="22" ry="30" fill="${salvia}"/><ellipse cx="43" cy="48" rx="6" ry="9" fill="#B6C7A2" opacity=".5"/>${hojita}`),
