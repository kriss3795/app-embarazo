<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#E8919C">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>Para la Vale</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --durazno:#FBF3EF;
  --papel:#FFFBF9;
  --rosa:#E8919C;
  --rosa-hondo:#C56B7A;
  --rosa-suave:#F6DCE0;
  --salvia:#9CAF88;
  --dorado:#D4A574;
  --tinta:#5A464A;
  --tinta-suave:#8A757A;
  --sombra:rgba(197,107,122,.14);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{background:var(--durazno)}
body{
  font-family:'Nunito',sans-serif;
  color:var(--tinta);
  line-height:1.6;
  min-height:100vh;
  min-height:100dvh;
  overflow-x:hidden;
}
.wrap{max-width:480px;margin:0 auto;padding:0 20px 60px;position:relative}

/* fondo decorativo suave */
.blob{position:fixed;border-radius:50%;filter:blur(60px);opacity:.5;z-index:0;pointer-events:none}
.blob1{width:280px;height:280px;background:var(--rosa-suave);top:-80px;right:-100px}
.blob2{width:240px;height:240px;background:#E6EFDD;bottom:-60px;left:-90px}
.wrap>*{position:relative;z-index:1}

/* ---------- ENCABEZADO ---------- */
header{text-align:center;padding:36px 0 10px}
.corazon{font-size:20px;color:var(--rosa);animation:latir 2.6s ease-in-out infinite}
@keyframes latir{0%,100%{transform:scale(1)}12%{transform:scale(1.22)}24%{transform:scale(1)}36%{transform:scale(1.15)}}
header h1{
  font-family:'Fraunces',serif;
  font-weight:500;
  font-size:15px;
  letter-spacing:.5px;
  color:var(--tinta-suave);
  margin-top:6px;
}
.fecha-hoy{font-size:12.5px;color:var(--tinta-suave);margin-top:2px}

/* ---------- BLOQUE PRINCIPAL: PROGRESO ---------- */
.hero{text-align:center;padding:16px 0 8px}
.semana-grande{
  font-family:'Fraunces',serif;
  font-weight:400;
  font-size:52px;
  line-height:1;
  color:var(--rosa-hondo);
  letter-spacing:-1px;
}
.semana-sub{
  font-family:'Fraunces',serif;
  font-style:italic;
  font-size:19px;
  color:var(--rosa);
  margin-top:6px;
}
.dia-de{font-size:13px;color:var(--tinta-suave);margin-top:8px}

/* barra de progreso tierna */
.barra{
  height:12px;background:var(--rosa-suave);border-radius:20px;
  margin:22px 8px 6px;overflow:hidden;position:relative;
}
.barra-fill{height:100%;background:linear-gradient(90deg,var(--rosa),var(--dorado));border-radius:20px;transition:width 1.2s ease}
.progreso-txt{font-size:12px;color:var(--tinta-suave);text-align:center}

/* ---------- FRUTA / TAMAÑO ---------- */
.fruta-card{
  background:var(--papel);
  border-radius:32px;
  padding:26px 22px 24px;
  margin:24px 0;
  text-align:center;
  box-shadow:0 12px 30px var(--sombra);
}
.fruta-label{font-size:13px;color:var(--tinta-suave)}
.fruta-svg{margin:8px auto 4px;width:110px;height:110px}
.fruta-nombre{
  font-family:'Fraunces',serif;
  font-size:24px;
  font-weight:500;
  color:var(--rosa-hondo);
  text-transform:lowercase;
}
.fruta-datos{
  display:flex;justify-content:center;gap:22px;margin-top:14px;
  font-size:13px;color:var(--tinta-suave);
}
.fruta-datos b{display:block;font-family:'Fraunces',serif;font-size:19px;color:var(--tinta);font-weight:500}

/* ---------- CARTA DEL DÍA ---------- */
.carta{
  background:linear-gradient(160deg,#FFF6F2,#FDEDE8);
  border:1.5px solid var(--rosa-suave);
  border-radius:28px;
  padding:26px 24px;
  margin:26px 0;
  position:relative;
}
.carta::before{
  content:"❝";
  font-family:'Fraunces',serif;
  position:absolute;top:6px;left:18px;
  font-size:44px;color:var(--rosa-suave);line-height:1;
}
.carta-de{
  font-size:12px;color:var(--rosa-hondo);
  letter-spacing:.5px;margin-bottom:8px;padding-left:26px;
}
.carta-texto{
  font-family:'Fraunces',serif;
  font-style:italic;
  font-size:19px;
  line-height:1.55;
  color:var(--tinta);
  padding-left:8px;
}
.carta-firma{
  text-align:right;font-family:'Fraunces',serif;
  font-size:16px;color:var(--rosa-hondo);margin-top:14px;
}

/* ---------- SECCIONES ---------- */
.seccion{margin:22px 0}
.seccion-titulo{
  display:flex;align-items:center;gap:10px;
  font-family:'Fraunces',serif;font-weight:500;font-size:18px;
  color:var(--rosa-hondo);margin-bottom:10px;
}
.seccion-titulo .ico{font-size:20px}
.seccion-texto{
  background:var(--papel);border-radius:22px;padding:18px 20px;
  font-size:15px;color:var(--tinta);box-shadow:0 6px 18px var(--sombra);
}
.mision .seccion-texto{background:#F2F6EC;box-shadow:0 6px 18px rgba(156,175,136,.16)}
.mision .seccion-titulo{color:#6E8256}
.dato .seccion-texto{
  background:transparent;box-shadow:none;font-size:13.5px;
  color:var(--tinta-suave);font-style:italic;text-align:center;padding:6px 10px;
}
.fcf{color:var(--rosa-hondo);font-weight:700;font-style:normal}

/* ---------- CONFIG ---------- */
.config-btn{
  position:fixed;top:18px;right:calc(50% - 240px + 20px);
  width:40px;height:40px;border-radius:50%;
  background:var(--papel);border:none;box-shadow:0 4px 12px var(--sombra);
  font-size:18px;cursor:pointer;z-index:20;color:var(--rosa-hondo);
}
@media(max-width:520px){.config-btn{right:18px}}
.overlay{
  position:fixed;inset:0;background:rgba(90,70,74,.4);z-index:30;
  display:none;align-items:flex-end;justify-content:center;
  backdrop-filter:blur(3px);
}
.overlay.open{display:flex}
.modal{
  background:var(--durazno);width:100%;max-width:480px;
  border-radius:32px 32px 0 0;padding:28px 24px 40px;
  max-height:88vh;overflow-y:auto;animation:subir .35s ease;
}
@keyframes subir{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal h2{font-family:'Fraunces',serif;font-weight:500;font-size:22px;color:var(--rosa-hondo);margin-bottom:4px}
.modal p.sub{font-size:13px;color:var(--tinta-suave);margin-bottom:20px}
.campo{margin-bottom:18px}
.campo label{display:block;font-size:13.5px;color:var(--tinta);margin-bottom:6px;font-weight:600}
.campo input{
  width:100%;padding:13px 15px;border:1.5px solid var(--rosa-suave);
  border-radius:16px;background:var(--papel);font-family:'Nunito';
  font-size:15px;color:var(--tinta);
}
.campo input:focus{outline:none;border-color:var(--rosa)}
.sexo-opts{display:flex;gap:8px}
.sexo-opts button{
  flex:1;padding:12px 4px;border:1.5px solid var(--rosa-suave);
  border-radius:16px;background:var(--papel);font-family:'Nunito';
  font-size:13px;font-weight:600;color:var(--tinta-suave);cursor:pointer;
  transition:all .2s;
}
.sexo-opts button.sel{background:var(--rosa);color:#fff;border-color:var(--rosa)}
.guardar{
  width:100%;padding:15px;border:none;border-radius:18px;
  background:var(--rosa-hondo);color:#fff;font-family:'Nunito';
  font-size:16px;font-weight:700;cursor:pointer;margin-top:6px;
}
.link-cerrar{display:block;text-align:center;margin-top:14px;font-size:13px;color:var(--tinta-suave);cursor:pointer;background:none;border:none;width:100%}

/* recordatorio eco */
.aviso-eco{
  background:linear-gradient(135deg,#FBEEDD,#F8E4CE);
  border:1.5px dashed var(--dorado);border-radius:22px;
  padding:16px 18px;margin:22px 0;font-size:14px;color:#8A6636;
  display:flex;gap:12px;align-items:flex-start;
}
.aviso-eco .ico{font-size:22px}

footer{text-align:center;margin-top:36px;font-size:12px;color:var(--tinta-suave)}
footer .corazon-mini{color:var(--rosa)}
</style>
</head>
<body>

<button class="config-btn" onclick="abrirConfig()">⚙</button>

<div class="blob blob1"></div>
<div class="blob blob2"></div>

<div class="wrap">
  <header>
    <div class="corazon">♥</div>
    <h1 id="titulo-app">Para la Vale, con amor</h1>
    <div class="fecha-hoy" id="fecha-hoy"></div>
  </header>

  <div class="hero">
    <div class="semana-grande" id="semana-grande">—</div>
    <div class="semana-sub" id="semana-sub"></div>
    <div class="dia-de" id="dia-de"></div>
    <div class="barra"><div class="barra-fill" id="barra-fill" style="width:0"></div></div>
    <div class="progreso-txt" id="progreso-txt"></div>
  </div>

  <div class="aviso-eco" id="aviso-eco" style="display:none">
    <div class="ico">🩺</div>
    <div id="aviso-eco-txt"></div>
  </div>

  <div class="fruta-card">
    <div class="fruta-label">Esta semana nuestra guagua es del tamaño de una</div>
    <div class="fruta-svg" id="fruta-svg"></div>
    <div class="fruta-nombre" id="fruta-nombre">—</div>
    <div class="fruta-datos">
      <div><b id="dato-largo">—</b>largo aprox.</div>
      <div><b id="dato-peso">—</b>peso aprox.</div>
      <div><b id="dato-fcf">—</b>corazoncito</div>
    </div>
  </div>

  <div class="carta">
    <div class="carta-de">Una nota de tu compañero de equipo</div>
    <div class="carta-texto" id="carta-texto">—</div>
    <div class="carta-firma">— con todo mi amor</div>
  </div>

  <div class="seccion">
    <div class="seccion-titulo"><span class="ico">🌸</span><span id="t-bebe">Nuestra guagua hoy</span></div>
    <div class="seccion-texto" id="txt-bebe">—</div>
  </div>

  <div class="seccion">
    <div class="seccion-titulo"><span class="ico">💗</span>Tu cuerpo, Vale</div>
    <div class="seccion-texto" id="txt-cuerpo">—</div>
  </div>

  <div class="seccion mision">
    <div class="seccion-titulo"><span class="ico">🌿</span>Lo que yo puedo hacer hoy</div>
    <div class="seccion-texto" id="txt-mision">—</div>
  </div>

  <div class="seccion dato">
    <div class="seccion-texto" id="txt-dato">—</div>
  </div>

  <footer>
    Hecho a mano, con <span class="corazon-mini">♥</span>, para ti y para nuestra guagua.
  </footer>
</div>

<!-- CONFIGURACIÓN -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h2>Nuestros datos</h2>
    <p class="sub">Esto se guarda solo en este teléfono. Nada se sube a internet.</p>

    <div class="campo">
      <label>¿Cómo se llama la mamá?</label>
      <input type="text" id="in-mama" placeholder="Vale">
    </div>
    <div class="campo">
      <label>¿Cómo te llamas tú (el papá)?</label>
      <input type="text" id="in-papa" placeholder="Kriss">
    </div>
    <div class="campo">
      <label>Fecha de última regla (FUR)</label>
      <input type="date" id="in-fur">
    </div>
    <div class="campo">
      <label>...o Fecha Probable de Parto (FPP)</label>
      <input type="date" id="in-fpp">
    </div>
    <div class="campo">
      <label>¿Ya saben qué viene?</label>
      <div class="sexo-opts" id="sexo-opts">
        <button data-sexo="sorpresa" class="sel">Sorpresa 💛</button>
        <button data-sexo="nina">Niña 💗</button>
        <button data-sexo="nino">Niño 💙</button>
      </div>
    </div>

    <button class="guardar" onclick="guardar()">Guardar</button>
    <button class="link-cerrar" onclick="cerrarConfig()">Cerrar</button>
  </div>
</div>

<script src="data.js"></script>
<script>
// ============= ESTADO / ALMACENAMIENTO =============
const KEY='vale_guagua_v1';
let cfg = cargarCfg();

function cargarCfg(){
  try{ return JSON.parse(localStorage.getItem(KEY)) || {}; }
  catch(e){ return {}; }
}
function guardarCfg(){ localStorage.setItem(KEY, JSON.stringify(cfg)); }

// ============= FECHAS =============
const MESES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const DIAS=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];

function hoyMedianoche(){ const d=new Date(); d.setHours(0,0,0,0); return d; }

// Devuelve la fecha de anclaje (FUR). Si el usuario puso FPP, resta 280.
function fechaAnclaje(){
  if(cfg.fur) return new Date(cfg.fur+'T00:00:00');
  if(cfg.fpp){ const f=new Date(cfg.fpp+'T00:00:00'); f.setDate(f.getDate()-280); return f; }
  return null;
}

function diasGestacion(){
  const anc=fechaAnclaje(); if(!anc) return null;
  const diff = hoyMedianoche() - anc;
  return Math.floor(diff / 86400000);
}

// ============= FRUTA SVG (dibujos simples y tiernos) =============
