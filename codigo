    "cebolla":g(`<path d="M50 30 C32 30 30 56 40 74 C46 84 54 84 60 74 C70 56 68 30 50 30 Z" fill="#EAD9C0"/><path d="M50 30 q-6 30 0 48 M50 30 q6 30 0 48" stroke="#D4BFA0" stroke-width="1.5" fill="none"/><path d="M46 30 l8 -12 M50 30 l0 -14 M54 30 l-4 -12" stroke="${hoja}" stroke-width="2"/>`),
    "mango":g(`<path d="M40 30 C64 22 82 44 72 66 C64 82 44 84 34 68 C26 52 28 34 40 30 Z" fill="${dorado}"/><path d="M44 40 C58 36 68 48 64 60" stroke="#E8B876" stroke-width="3" fill="none" opacity=".5"/>${hojita}`),
    "plátano":g(`<path d="M28 40 C34 70 62 80 76 60 C70 66 44 60 38 38 Z" fill="${dorado}"/><path d="M30 40 C38 68 62 76 74 60" stroke="#C79656" stroke-width="2" fill="none"/>`),
    "papaya pequeña":g(`<path d="M40 26 C64 26 74 52 66 74 C60 86 40 86 34 72 C26 50 30 26 40 26Z" fill="#E8945A"/><ellipse cx="52" cy="60" rx="10" ry="16" fill="#C46A3E"/><g fill="#5A3A28">${[...Array(5)].map((_,i)=>`<circle cx="52" cy="${50+i*6}" r="2"/>`).join('')}</g>${hojita}`),
    "pomelo":g(`<circle cx="50" cy="56" r="33" fill="#F1A6A0"/><circle cx="42" cy="46" r="9" fill="#F7C5C1" opacity=".5"/>${hojita}`),
    "choclo":g(`<ellipse cx="50" cy="56" rx="18" ry="32" fill="${dorado}"/><g fill="#E8C878">${[...Array(20)].map((_,i)=>`<circle cx="${42+(i%3)*8}" cy="${34+Math.floor(i/3)*7}" r="3"/>`).join('')}</g><path d="M40 30 l-8 -14 M50 26 l0 -16 M60 30 l8 -14" stroke="${hoja}" stroke-width="3"/>`),
    "coliflor":g(`<g fill="#F0EBDD">${[...Array(7)].map((_,i)=>`<circle cx="${38+(i%3)*12}" cy="${40+Math.floor(i/3)*11}" r="10"/>`).join('')}</g><path d="M34 60 h32 v14 a4 4 0 0 1 -4 4 h-24 a4 4 0 0 1 -4 -4 z" fill="#A8BE8E"/>`),
    "lechuga":g(`<g fill="#A8C48A">${[...Array(6)].map((_,i)=>`<circle cx="${38+(i%3)*12}" cy="${44+Math.floor(i/2)*12}" r="12"/>`).join('')}</g><circle cx="50" cy="52" r="14" fill="#C2D8A8"/>`),
    "repollo pequeño":g(`<circle cx="50" cy="56" r="30" fill="#A8C48A"/><path d="M50 26 q-16 30 0 60 M50 26 q16 30 0 60 M22 56 q28 -14 56 0" stroke="#88A870" stroke-width="1.5" fill="none"/>`),
    "repollo grande":g(`<circle cx="50" cy="56" r="33" fill="#9CB87E"/><path d="M50 23 q-18 33 0 66 M50 23 q18 33 0 66 M18 56 q32 -16 64 0" stroke="#7E9868" stroke-width="1.5" fill="none"/>`),
    "berenjena":g(`<path d="M42 32 C66 30 74 54 64 74 C56 88 40 86 36 70 C32 52 30 34 42 32 Z" fill="#8B5A9E"/><path d="M46 30 q-4 -10 8 -12 q10 4 4 14" fill="${hoja}"/>`),
    "zapallo italiano":g(`<ellipse cx="50" cy="58" rx="16" ry="30" fill="#6E9B5C"/><ellipse cx="44" cy="50" rx="5" ry="12" fill="#8FB87A" opacity=".5"/><path d="M50 28 l0 -12" stroke="${hoja}" stroke-width="3"/>${hojita}`),
    "coco":g(`<circle cx="50" cy="56" r="31" fill="#8B6B4A"/><circle cx="50" cy="56" r="31" fill="#6E5238" opacity=".3"/><circle cx="42" cy="48" r="4" fill="#3A2A1C"/><circle cx="56" cy="46" r="4" fill="#3A2A1C"/><circle cx="50" cy="58" r="4" fill="#3A2A1C"/>`),
    "apio entero":g(`<g stroke="#7E9868" stroke-width="8" stroke-linecap="round"><path d="M42 82 L38 34"/><path d="M50 82 L50 30"/><path d="M58 82 L62 34"/></g><g fill="#A8C48A">${[...Array(6)].map((_,i)=>`<circle cx="${36+i*6}" cy="${28-(i%2)*6}" r="7"/>`).join('')}</g>`),
    "piña":g(`<ellipse cx="50" cy="62" rx="24" ry="28" fill="${dorado}"/><path d="M35 50 l30 18 M65 50 l-30 18 M40 40 l20 40 M60 40 l-20 40" stroke="#C79656" stroke-width="1.5"/><g fill="${hoja}"><path d="M50 34 l-10 -22 l6 22 M50 30 l0 -26 M50 34 l10 -22 l-6 22"/></g>`),
    "melón pequeño":g(`<circle cx="50" cy="56" r="30" fill="#C9D89E"/><path d="M28 50 q22 -10 44 0 M26 62 q24 -6 48 0" stroke="#A8BE7E" stroke-width="1.5" fill="none"/>${hojita}`),
    "melón calameño":g(`<circle cx="50" cy="56" r="32" fill="#D6C888"/><g stroke="#B8A868" stroke-width="1" fill="none">${[...Array(12)].map((_,i)=>`<path d="M50 24 q${(i-6)*4} 32 0 64"/>`).join('')}</g>`),
    "lechuga grande":g(`<g fill="#A8C48A">${[...Array(7)].map((_,i)=>`<circle cx="${36+(i%3)*14}" cy="${42+Math.floor(i/2)*13}" r="13"/>`).join('')}</g><circle cx="50" cy="52" r="15" fill="#C2D8A8"/>`),
    "acelga entera":g(`<g stroke="#E8E0C0" stroke-width="7" stroke-linecap="round"><path d="M44 82 L40 40"/><path d="M56 82 L60 40"/></g><g fill="#5E8248"><path d="M40 40 q-14 -18 4 -30 q8 14 -4 30" /><path d="M60 40 q14 -18 -4 -30 q-8 14 4 30"/></g>`),
    "puerro":g(`<rect x="42" y="42" width="16" height="42" rx="6" fill="#EAE4CE"/><g fill="#6E9B5C"><path d="M42 44 q-10 -30 4 -40 q6 20 -4 40" /><path d="M58 44 q10 -30 -4 -40 q-6 20 4 40"/><path d="M50 42 l0 -44"/></g>`),
    "sandía pequeña":g(`<circle cx="50" cy="56" r="30" fill="#5E8248"/><path d="M25 48 q25 -12 50 0 M23 60 q27 -8 54 0" stroke="#7EA060" stroke-width="2" fill="none"/>${hojita}`),
    "sandía":g(`<circle cx="50" cy="56" r="34" fill="#5E8248"/><g stroke="#7EA060" stroke-width="2.5" fill="none">${[...Array(6)].map((_,i)=>`<path d="M50 22 q${(i-3)*7} 34 0 68"/>`).join('')}</g>`)
  };
  // genérica tierna (semillita) para semanas muy tempranas o sin dibujo
  const generica=g(`<circle cx="50" cy="56" r="10" fill="${rosa}"/><circle cx="50" cy="56" r="20" fill="${rosa}" opacity=".2"/><circle cx="50" cy="56" r="28" fill="${rosa}" opacity=".1"/>`);
  return map[nombre] || generica;
}

// ============= PRONOMBRES SEGÚN SEXO =============
function palabras(){
  if(cfg.sexo==='nina') return {suj:'nuestra hija', art:'la', posesivo:'nuestra hija'};
  if(cfg.sexo==='nino') return {suj:'nuestro hijo', art:'el', posesivo:'nuestro hijo'};
  return {suj:'nuestra guagua', art:'', posesivo:'nuestra guagua'};
}

// ============= RENDER =============
function fmtFecha(d){ return `${DIAS[d.getDay()]} ${d.getDate()} de ${MESES[d.getMonth()]}`; }

function render(){
  const mama = cfg.mama || 'Vale';
  document.getElementById('titulo-app').textContent = `Para ${mama}, con amor`;
  document.getElementById('fecha-hoy').textContent = fmtFecha(hoyMedianoche());

  const dias = diasGestacion();

  if(dias===null){
    document.getElementById('semana-grande').textContent='♥';
    document.getElementById('semana-sub').textContent='Configuremos la fecha';
    document.getElementById('dia-de').textContent='Toca el engranaje ⚙ arriba para empezar';
    document.getElementById('carta-texto').textContent='Ingresa la fecha de última regla o la fecha probable de parto, y esta app cobra vida.';
    return;
  }

  const sem = Math.floor(dias/7);
  const diaExtra = dias % 7;
  const semClamp = Math.max(4, Math.min(40, sem));

  document.getElementById('semana-grande').textContent = `Semana ${sem}`;
  document.getElementById('semana-sub').textContent = `+ ${diaExtra} ${diaExtra===1?'día':'días'}`;
  document.getElementById('dia-de').textContent = `Día ${dias} de 280`;

  // progreso
  const pct = Math.max(0, Math.min(100, (dias/280)*100));
  document.getElementById('barra-fill').style.width = pct.toFixed(1)+'%';
  const faltan = 280 - dias;
  document.getElementById('progreso-txt').textContent =
    `${pct.toFixed(1)}% recorrido · ${faltan>0? 'faltan '+faltan+' días para conocerla':'ya es el momento ♥'}`;

  // fruta
  const nombre = FRUTAS[semClamp] || 'semillita';
  document.getElementById('fruta-nombre').textContent = nombre;
  document.getElementById('fruta-svg').innerHTML = frutaSVG(nombre);

  // biometría
  const bio = BIOMETRIA[semClamp] || [0.1,0.5];
  const largo = bio[0] < 1 ? (bio[0]*10).toFixed(0)+' mm' : bio[0].toFixed(1)+' cm';
  const peso = bio[1] < 1000 ? Math.round(bio[1])+' g' : (bio[1]/1000).toFixed(1)+' kg';
  document.getElementById('dato-largo').textContent = largo;
  document.getElementById('dato-peso').textContent = peso;
  const fcf = FCF[semClamp] || '~140 lpm';
  document.getElementById('dato-fcf').innerHTML = `<span class="fcf">${fcf==='—'?'♥':fcf}</span>`;

  // contenido semanal
  const c = SEMANAS[semClamp] || SEMANAS[11];
  const p = palabras();
  const reemplaza = (t)=> t
    .replace(/nuestra guagua/g, p.posesivo)
    .replace(/Vale\b/g, mama)
    .replace(/la guagua/g, cfg.sexo==='nina'?'la niña':cfg.sexo==='nino'?'el niño':'la guagua');

  document.getElementById('t-bebe').textContent = cfg.sexo==='nina'?'Nuestra hija hoy':cfg.sexo==='nino'?'Nuestro hijo hoy':'Nuestra guagua hoy';
  document.getElementById('txt-bebe').textContent = reemplaza(c.bebe);
  document.getElementById('txt-cuerpo').textContent = reemplaza(c.cuerpo);
  document.getElementById('txt-mision').textContent = reemplaza(c.mision);
  document.getElementById('carta-texto').textContent = reemplaza(c.carta);
  document.getElementById('txt-dato').textContent = reemplaza(c.dato);

  // aviso de eco 11-14
  const eco = document.getElementById('aviso-eco');
  if(sem>=11 && sem<=13){
    eco.style.display='flex';
    document.getElementById('aviso-eco-txt').innerHTML =
      `<b>Ventana de la eco importante (11 a 14 semanas).</b> Es un momento lindo para vivir juntos: van a poder ver a ${p.posesivo} moverse en la pantalla.`;
  } else if(sem>=24 && sem<=28){
    eco.style.display='flex';
    document.getElementById('aviso-eco-txt').innerHTML =
      `<b>Etapa del test de glucosa (24 a 28 semanas).</b> Acompáñala si puedes: se hace más liviano de a dos.`;
  } else if(sem>=35 && sem<=37){
    eco.style.display='flex';
    document.getElementById('aviso-eco-txt').innerHTML =
      `<b>Cultivo estreptococo grupo B (35 a 37 semanas).</b> Un examen simple e importante antes de la recta final.`;
  } else {
    eco.style.display='none';
  }

  // firma con el nombre del papá
  document.querySelector('.carta-firma').textContent = cfg.papa? `— ${cfg.papa}, con todo mi amor` : '— con todo mi amor';
}

// ============= CONFIG UI =============
function abrirConfig(){
  document.getElementById('in-mama').value = cfg.mama||'';
  document.getElementById('in-papa').value = cfg.papa||'';
  document.getElementById('in-fur').value = cfg.fur||'';
  document.getElementById('in-fpp').value = cfg.fpp||'';
  document.querySelectorAll('#sexo-opts button').forEach(b=>{
    b.classList.toggle('sel', b.dataset.sexo === (cfg.sexo||'sorpresa'));
  });
  document.getElementById('overlay').classList.add('open');
}
function cerrarConfig(){ document.getElementById('overlay').classList.remove('open'); }

document.querySelectorAll('#sexo-opts button').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('#sexo-opts button').forEach(x=>x.classList.remove('sel'));
    b.classList.add('sel');
  };
});

function guardar(){
  cfg.mama = document.getElementById('in-mama').value.trim() || 'Vale';
  cfg.papa = document.getElementById('in-papa').value.trim();
  const fur = document.getElementById('in-fur').value;
  const fpp = document.getElementById('in-fpp').value;
  cfg.fur = fur || '';
  cfg.fpp = fur ? '' : fpp; // FUR tiene prioridad
  cfg.sexo = document.querySelector('#sexo-opts button.sel').dataset.sexo;
  guardarCfg();
  cerrarConfig();
  render();
}

// cerrar modal al tocar fuera
document.getElementById('overlay').onclick=(e)=>{ if(e.target.id==='overlay') cerrarConfig(); };

// ============= ARRANQUE =============
render();
// re-render cada vez que se vuelve a la app (nuevo día)
document.addEventListener('visibilitychange',()=>{ if(!document.hidden) render(); });
</script>
</body>
</html>
